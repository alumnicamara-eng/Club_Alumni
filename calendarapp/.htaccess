# ==========================================================
# Cabeceras de caché — Club Alumni Cámara FP
# Objetivo: que las actualizaciones lleguen solas a todos los
# usuarios, sin tener que limpiar caché manualmente.
# ==========================================================

<IfModule mod_headers.c>
  # HTML, JS, CSS, SW y manifest: SIEMPRE revalidar con el servidor.
  # El navegador usa ETag → descarga solo si cambió (304 si no).
  <FilesMatch "\.(html|js|css|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # El Service Worker nunca debe cachearse (clave para que se actualice).
  <FilesMatch "sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Imágenes y fuentes: cambian poco → caché larga (carga instantánea).
  <FilesMatch "\.(png|jpe?g|gif|svg|webp|ico|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Seguridad básica
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Comprimir texto (más rápido para todos)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Sin listado de directorios
Options -Indexes
